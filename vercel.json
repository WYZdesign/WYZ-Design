{
  "ignoreCommand": "node -e 'const k=process.env.VERCEL_API_KEY||process.env.VERCEL_DEPLOY_TOKEN;fetch(\"https://api.vercel.com/v6/deployments?projectId=prj_NTkWtVYYEaldcK9agG3U8kYjCS54&limit=25\",{headers:{Authorization:\"Bearer \"+k,Accept:\"application/json\"}}).then(r=>r.json()).then(d=>{const x=(d.deployments||[]).find(y=>y.readyState===\"READY\"&&y.target===\"production\");process.stdout.write(x&&x.meta?x.meta.githubCommitSha||\"\":\"\")}).catch(()=>{})' > /tmp/last_live_sha 2>/dev/null; B=$(cat /tmp/last_live_sha 2>/dev/null); F=\"src public package.json package-lock.json next.config.ts next.config.js vercel.json tsconfig.json\"; if [ -n \"$B\" ]; then if git diff --quiet \"$B\" HEAD -- $F; then echo skip-no-app-changes-since-$B; exit 0; else echo build-app-changes-since-$B; exit 1; fi; else echo last-live-sha-unavailable-build; exit 1; fi",
  "crons": [
    { "path": "/api/health", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/booking-whatsnext", "schedule": "0 16 * * *" }
  ],
  "headers": [
    {
      "source": "/videos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://www.wyzdesign.com" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" },
        { "key": "Access-Control-Max-Age", "value": "86400" },
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ],
  "redirects": [
    { "source": "/muse", "destination": "https://muse.wyzdesign.com/muse", "permanent": true },
    { "source": "/muse/(.*)", "destination": "https://muse.wyzdesign.com/muse/$1", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "wyzdesign.com" }], "destination": "https://www.wyzdesign.com/:path*", "permanent": true }
  ],
  "functions": {
    "src/app/api/**/*.ts": {
      "memory": 512,
      "maxDuration": 30
    }
  }
}
